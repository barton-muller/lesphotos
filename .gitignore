# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generated fake library and PhotoView state
server/data/photos/
server/data/photoview/

# Client-side sync cache (stands in for on-device storage)
client/cache/

# appdb is real local state (favorites/moment labels), not source -
# regenerates from PhotoView via import_favorites_from_photoview() if lost
server/data/appdb.sqlite3

# client web build output / local deps
client/web/node_modules/
client/web/dist/

sandbox/
server/data/cache/
server/data/appdb.sqlite3-shm
server/data/appdb.sqlite3-wal

# Real deployment secrets (LESPHOTOS_SECRET). The .example is committed.
deploy/lesphotos.env

# Test account passwords (local dev users, NAS test/throwaway accounts) -
# never in git, CLAUDE.md, or memory. See deploy/test-credentials.md.example.
deploy/test-credentials.md

# GeoNames cities15000 dataset - fetched on demand via
# `python tools/city_lookup.py --fetch`, not source.
tools/data/

# @playwright/test's isolated test instance data dir + its own reports -
# see client/web/tests/setup/test-server.sh and playwright.config.ts.
client/web/tests/.data/
client/web/test-results/
client/web/playwright-report/
client/web/blob-report/

# Local account DB (usernames, scrypt hashes, library paths) - person-specific,
# created by `manage.py add-user`. Never committed.
server/data/auth.sqlite3*

# Personal place overrides (real coordinates). Copy
# tools/custom_locations.example.json to tools/custom_locations.json and edit.
tools/custom_locations.json

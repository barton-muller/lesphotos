# Copy to deploy/lesphotos.env on the NAS and fill in. Never commit the real one.

# REQUIRED. Signs session cookies. If this changes, everyone is logged out -
# so generate it ONCE and keep it:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
LESPHOTOS_SECRET=

# Where the auth database (accounts) lives. NOT where photos or thumbnails
# live - each user's library keeps its own state in <library>/.lesphotos/.
LESPHOTOS_DATA_DIR=/volume1/lesphotos-data

# Built PWA. Defaults to ../client/web/dist relative to server/, which is
# correct for a plain git checkout; set it only if you moved things.
#LESPHOTOS_CLIENT_DIST=/volume1/lesphotos/client/web/dist

# Only needed to point `vite dev` on a laptop at this server. Leave empty
# in production - the server serves the client itself, so it's same-origin
# and needs no CORS headers at all.
#LESPHOTOS_CORS_ORIGINS=http://192.168.1.50:5173

LESPHOTOS_PORT=8001
